{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Electron Main (only my code)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "timeout": 30000,
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/.vite/build/**/*.js"],
      "sourceMapPathOverrides": {
        "vite:///src/*": "${workspaceFolder}/src/*"
      },
      "skipFiles": [
        "<node_internals>/**",
        "node_modules/**",
        "${workspaceFolder}/.vite/build/**/*.js"
      ]
    }
  ]
}
