{
  "name": "codegym",
  "productName": "codegym",
  "version": "0.0.1",
  "description": "An application for practicing competitive programming",
  "main": ".vite/build/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpgmoreira/codegym.git"
  },
  "homepage": "https://github.com/jpgmoreira/codegym",
  "scripts": {
    "start": "electron-forge start",
    "start:perf": "ENABLE_PERFORMANCE_LOGS=true electron-forge start",
    "debug": "electron-forge start -- --inspect=9229 --remote-debugging-port=9222",
    "debug:perf": "ENABLE_PERFORMANCE_LOGS=true electron-forge start -- --inspect=9229 --remote-debugging-port=9222",
    "make": "electron-forge make",
    "pretty": "prettier . --write",
    "check": "vue-tsc --noEmit",
    "madge": "madge --circular src/main/**/*.ts src/common/**/*.ts"
  },
  "keywords": [],
  "author": {
    "name": "joao",
    "email": "jpgmoreira19@gmail.com"
  },
  "license": "MIT",
